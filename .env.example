# Copy this file to .env before running docker compose
# cp .env.example .env

# PostgreSQL
POSTGRES_DB=ssg_db
POSTGRES_USER=ssg
POSTGRES_PASSWORD=ssg123

# Backend (FastAPI)
DATABASE_URL=postgresql://ssg:ssg123@db:5432/ssg_db
MEDIA_ROOT=/app/media
CORS_ORIGINS=*

# Qwen VLM service (runs on host via WSL2 or native Linux)
# Windows: http://host.docker.internal:8001
# Linux:   http://172.17.0.1:8001  (docker bridge gateway)
QWEN_SERVICE_URL=http://host.docker.internal:8001
QWEN_MODEL=Qwen/Qwen2.5-VL-3B-Instruct

# Ports (change if port conflicts)
FRONTEND_PORT=5173
BACKEND_PORT=8000
DB_PORT=5432
PGADMIN_PORT=5050

# pgAdmin (optional, start with: make up-tools)
PGADMIN_EMAIL=admin@lineguard.local
PGADMIN_PASSWORD=admin123
