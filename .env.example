# Copy this file to .env before running docker compose
# cp .env.example .env

# PostgreSQL
POSTGRES_DB=ssg_db
POSTGRES_USER=ssg
POSTGRES_PASSWORD=ssg123

# Backend (FastAPI)
DATABASE_URL=postgresql://ssg:ssg123@db:5432/ssg_db
MEDIA_ROOT=/app/media
CORS_ORIGINS=*

# Ports (change if port conflicts)
FRONTEND_PORT=5173
BACKEND_PORT=8000
DB_PORT=5432
PGADMIN_PORT=5050

# pgAdmin (optional, start with: make up-tools)
PGADMIN_EMAIL=admin@lineguard.local
PGADMIN_PASSWORD=admin123
